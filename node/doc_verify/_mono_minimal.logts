inline [logic] .mono:

    square(7, short, 160, 80)
    playerLabel(p1, 1)

    roll(D) <- random_between(1, 6, D)

    nextPos(Pos, Steps, NewPos) <-
        Sum is Pos + Steps,
        NewPos is Sum mod 9

    canBuy(P, Idx, Price, Name) <-
        playerPos$$(P, Idx),
        square(Idx, Name, Price, _),
        Price > 0,
        \+ owns$$(Idx, _)

    initGame() <-
        commit(
            ~ greeted$(_),
            ~ phase$(_),
            ~ turn$(_),
            ~ playerPos$$(_, _),
            + phase$(waitRoll),
            + turn$(p1),
            + playerPos$$(p1, 0),
            + greeted$()
        ),
        show("Game Reset")

    query welcomeBoot:
        \+ greeted$(),
        initGame()

    query handleReset:
        initGame()

    query handleRoll:
        phase$(waitRoll),
        turn$(p1),
        playerPos$$(p1, Pos),
        roll(D1),
        roll(D2),
        S is D1 + D2,
        nextPos(Pos, S, NewPos),
        commit(+ playerPos$$(p1, NewPos)),
        show("Player 1 dice:", D1, D2),
        show("Player 1 position now:", NewPos),
        canBuy(p1, Idx, Price, Name),
        commit(+ phase$(waitChoice)),
        show("1 pass turn"),
        show("2 buy property", Name, ". cost:", Price)

:

comp [key] .key1:
    label: '1'
    type: 0
    nl
    :

comp [key] .resetGame:
    label: 'reset'
    type: 0
    nl
    :

comp [logic] .game:
    on: 1
    randomSeed: 42
    .mono { }
:

1wire bootStep = 1

.game:{
    query = welcomeBoot
    set = bootStep
}

.game:{
    bootStep = 0
    set = 1
}

.game:{
    query = handleRoll
    set = .key1
}

.game:{
    query = handleReset
    set = .resetGame
}
